+    kmod-fs-ext4 kmod-fs-vfat kmod-nls-cp437 kmod-nls-iso8859-1 \
+    kmod-usb-acm kmod-usb-serial kmod-usb-serial-option \
+    kmod-usb-net kmod-usb-net-cdc-ether kmod-usb-net-cdc-ncm \
+    kmod-usb-net-cdc-mbim kmod-usb-net-rndis kmod-usb-net-qmi-wwan \
+    usb-modeswitch uqmi umbim luci-proto-qmi luci-proto-ncm luci-proto-mbim
 endef
 TARGET_DEVICES += hilink_hlk-7628n
 
