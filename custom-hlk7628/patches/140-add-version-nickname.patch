@@ -5,3 +5,4 @@ DISTRIB_TARGET='%S'
 DISTRIB_ARCH='%A'
-DISTRIB_DESCRIPTION='%D %V %C'
+DISTRIB_DESCRIPTION='%D'
 DISTRIB_TAINTS='%t'
+DISTRIB_NICKNAME='%N'
